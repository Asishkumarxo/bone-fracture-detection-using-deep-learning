# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure values according to your local environment.
# ==============================================================================

# Dataset Root Locations
DATA_ROOT=./data
BONEFRACT_DIR=./data/BoneFract
FRACATLAS_DIR=./data/FracAtlas

# Model Checkpoints
MODEL_ROOT=./models/checkpoints
CLASSIFIER_CHECKPOINT=./models/checkpoints/best_model.pt
DETECTOR_CHECKPOINT=./models/checkpoints/best_detector.pt

# Inference Operating Thresholds
FRACTURE_THRESHOLD=0.50
DETECTOR_THRESHOLD=0.10
UNCERTAINTY_THRESHOLD=0.40

# REST API & Web Server Settings
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
