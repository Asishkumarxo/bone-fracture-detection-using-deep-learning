{
  "classifier": {
    "backbone": "resnet50",
    "image_size": [224, 224],
    "num_regions": 7,
    "batch_size": 32,
    "epochs_stage1": 3,
    "epochs_stage2": 2,
    "lr_stage1": 0.001,
    "lr_stage2": 0.0001,
    "dropout": 0.3,
    "fracture_threshold": 0.50,
    "uncertainty_threshold": 0.40
  },
  "detector": {
    "architecture": "fasterrcnn_mobilenet_v3_large_fpn",
    "target_size": [384, 384],
    "num_classes": 2,
    "confidence_threshold": 0.10,
    "batch_size": 2,
    "epochs": 2,
    "lr": 0.0001
  }
}
